app.js


const http = require('http');
const fs = require('fs');
const path = require('path');
const { MongoClient } = require('mongodb');

const url = 'mongodb://127.0.0.1:27017';
const client = new MongoClient(url);

function escapeHTML(value) {
    return String(value ?? '').replace(/[&<>"']/g, char => ({
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        '"': '&quot;',
        "'": '&#39;'
    })[char]);
}

async function startServer() {
    await client.connect();

    const db = client.db('tourismDB');
    const tourists = db.collection('tourists');

    const server = http.createServer(async (req, res) => {
        try {

            if (req.method === 'GET' && req.url === '/') {

                res.writeHead(200, {
                    'Content-Type': 'text/html; charset=utf-8'
                });

                fs.createReadStream(
                    path.join(__dirname, 'home.html')
                ).pipe(res);

            } else if (req.method === 'POST' && req.url === '/server') {

                let rawData = '';

                req.on('data', chunk => {
                    rawData += chunk;
                });

                req.on('end', async () => {

                    try {
                        const formData = new URLSearchParams(rawData);

                        const name = formData.get('name') || '';
                        const password = formData.get('password') || '';
                        const age = Number(formData.get('age'));
                        const mobile = formData.get('mobile') || '';
                        const email = formData.get('email') || '';
                        const gender = formData.get('gender') || '';
                        const state = formData.get('state') || '';
                        const destination = formData.get('destination') || '';
                        const skills = formData.getAll('skills');

                        if (
                            !name.trim() ||
                            password.length < 6 ||
                            !Number.isInteger(age) ||
                            age < 1 || age > 120 ||
                            !/^[0-9]{10}$/.test(mobile) ||
                            !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email) ||
                            !gender || !state || !destination ||
                            skills.length === 0
                        ) {
                            res.writeHead(400, {
                                'Content-Type': 'text/html; charset=utf-8'
                            });

                            return res.end(
                                '<h2>Invalid details. Please go back and complete the form correctly.</h2>'
                            );
                        }

                        const tourist = {
                            name: name.trim(),
                            password: password,
                            age,
                            mobile,
                            email,
                            gender,
                            state,
                            destination,
                            skills,
                            registeredAt: new Date()
                        };

                        const result = await tourists.insertOne(tourist);

                        const savedTourist = await tourists.findOne({
                            _id: result.insertedId
                        });

                        const rows = [
                            ['Name', savedTourist.name],
                            ['Password', '******'],
                            ['Age', savedTourist.age],
                            ['Mobile Number', savedTourist.mobile],
                            ['Email', savedTourist.email],
                            ['Gender', savedTourist.gender],
                            ['State', savedTourist.state],
                            ['Destination', savedTourist.destination],
                            ['Travel Interests', savedTourist.skills.join(', ')],
                            ['Registration Date', savedTourist.registeredAt.toLocaleString()]
                        ];

                        const tableRows = rows.map(([key, value]) => `
                            <tr>
                                <th>${escapeHTML(key)}</th>
                                <td>${escapeHTML(value)}</td>
                            </tr>
                        `).join('');

                        res.writeHead(200, {
                            'Content-Type': 'text/html; charset=utf-8'
                        });

                        res.end(`
                            <!DOCTYPE html>
                            <html lang="en">

                            <head>
                                <meta charset="UTF-8">
                                <meta name="viewport" content="width=device-width, initial-scale=1.0">
                                <title>Registration Successful</title>

                                <style>
                                    body {
                                        font-family: Arial, sans-serif;
                                        background: linear-gradient(135deg, #dff6f0, #dbeafe);
                                        padding: 25px;
                                        color: #1e293b;
                                    }

                                    .container {
                                        max-width: 750px;
                                        margin: 30px auto;
                                        background: white;
                                        padding: 25px;
                                        border-radius: 15px;
                                        box-shadow: 0 5px 20px #0002;
                                    }

                                    h1, p {
                                        text-align: center;
                                    }

                                    h1 {
                                        color: #075985;
                                    }

                                    table {
                                        width: 100%;
                                        border-collapse: collapse;
                                        margin-top: 20px;
                                    }

                                    th, td {
                                        border: 1px solid #cbd5e1;
                                        padding: 12px;
                                        text-align: left;
                                        overflow-wrap: anywhere;
                                    }

                                    th {
                                        background: #075985;
                                        color: white;
                                        width: 40%;
                                    }

                                    tr:nth-child(even) {
                                        background: #f1f5f9;
                                    }

                                    a {
                                        display: block;
                                        text-align: center;
                                        color: #075985;
                                        margin-top: 20px;
                                    }
                                </style>
                            </head>

                            <body>
                                <div class="container">

                                    <h1>Registration Successful!</h1>

                                    <p>
                                        Thank you for registering with Explore the World.
                                    </p>

                                    <table>
                                        <tr>
                                            <th>Field</th>
                                            <th>Value</th>
                                        </tr>

                                        ${tableRows}

                                    </table>

                                    <a href="/">Register Another Tourist</a>

                                </div>
                            </body>
                            </html>
                        `);

                    } catch (error) {

                        console.error(error);

                        if (!res.headersSent) {
                            res.writeHead(500, {
                                'Content-Type': 'text/plain'
                            });

                            res.end('Unable to process registration.');
                        }
                    }
                });

            } else {

                res.writeHead(404, {
                    'Content-Type': 'text/plain'
                });

                res.end('Page not found');
            }

        } catch (error) {

            console.error(error);

            if (!res.headersSent) {
                res.writeHead(500, {
                    'Content-Type': 'text/plain'
                });

                res.end('Server error');
            }
        }
    });

    server.listen(7000, () => {
        console.log('Server running at http://localhost:7000');
    });
}

startServer().catch(error => {
    console.error('Unable to start server:', error);
});


