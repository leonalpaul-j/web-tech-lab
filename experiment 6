<!DOCTYPE html>
<html>
<head>
    <title>Student Details - URK24CS1152</title>
    <style>
        body {
            font-family: Arial;
            text-align: center;
        }
        .student {
            margin: 15px auto;
            padding: 10px;
            width: 400px;
            border: 10px solid rgb(251, 9, 9);
        }
    </style>
</head>
<body>
<h1>Student Details - URK24CS1152</h1>
<div id="students"></div>
<script>
var students = [
    {
        name: "John",
        regno: "URK21CS1034",
        dob: 1998
    },
    {
        name: "gopi",
        regno: "URK24CS1156",
        dob: 2001
    },
    {
        name: "femin",
        regno: "URK23CS1131",
        dob: 1997
    }
];
for (var i = 0; i < students.length; i++) {
    var student = students[i];
    var category;
    if (student.dob < 2000) {
        category = "Born before 2000";
    }
    else {
        category = "Born after 2000";
    }
    document.getElementById("students").innerHTML +=
        "<div class='student'>" +
        "<b>" + student.name + "</b>'s Register Number is " +
        student.regno + "<br>" +
        "Year of Birth: " + student.dob + "<br>" +
        category +
        "</div>";
}
</script>
</body>
</html>
