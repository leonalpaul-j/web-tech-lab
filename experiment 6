<!DOCTYPE html>
<html>
<head>
    <title>Move Car - URK24CS1152</title>
    <style>
        body {
            text-align: center;
            font-family: Arial;
        }
        #car {
            position: relative;
            width: 550px;
            margin-top: 150px;
        }
    </style>
</head>
<body>
<h1>Move the Car - URK24CS1152</h1>
<button onclick="moveCar()">Move</button>
<button onclick="stopCar()">Stop</button>
<br>
<img id="car"
     src="D:\downloads\car.jpeg"
     alt="car">
<script>
var position = 0;
var timer;
function moveCar() {
    timer = setInterval(function() {
        position += 2;
        document.getElementById("car").style.left = position + "px";
    }, 20);
}
function stopCar() {
    clearInterval(timer);
}
</script>
</body>
</html>

